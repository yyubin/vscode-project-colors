{
  "name": "project-colors",
  "displayName": "Project Colors",
  "description": "Gives every project (open path) its own color on the title bar, activity bar, status bar and active tab.",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "projectColors.open",
        "title": "Open Color Picker",
        "category": "Project Colors",
        "icon": "$(symbol-color)"
      },
      {
        "command": "projectColors.change",
        "title": "Quick Pick Color",
        "category": "Project Colors"
      },
      {
        "command": "projectColors.next",
        "title": "Next Color",
        "category": "Project Colors"
      },
      {
        "command": "projectColors.reset",
        "title": "Remove Color from This Project",
        "category": "Project Colors"
      }
    ],
    "configuration": {
      "title": "Project Colors",
      "properties": {
        "projectColors.elements": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "titleBar",
              "activityBar",
              "statusBar",
              "activeTab"
            ]
          },
          "default": [
            "titleBar",
            "activityBar",
            "statusBar",
            "activeTab"
          ],
          "description": "Areas to color"
        },
        "projectColors.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the current color name in the status bar; click it to open the color picker."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --skip-license --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
